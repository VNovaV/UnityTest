# ===== Unity =====
# 注意：本仓库的 Unity 工程位于 game/ 子目录，不在仓库根目录。
# 因此这里所有 Unity 生成的目录都【不使用前导斜杠】，以便匹配任意层级。
# （GitHub 官方模板用的是 /[Ll]ibrary/ 这种绝对路径写法，在本仓库会失效！）

# --- 生成目录（体积最大，必须忽略）---
[Tt]emp/
[Ll]ibrary/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
.utmp/
*.log
sysinfo.txt

# --- IDE / 编辑器生成 ---
.vs/
.vsconfig
.gradle/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user

# --- Unity 自动生成的 meta ---
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- Blender 自动备份（不要提交）---
*.blend1
*.blend1.meta

# --- 崩溃报告 ---
mono_crash.*

# --- 构建产物 ---
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
crashlytics-build.properties
InitTestScene*.unity*

# --- Addressables 默认忽略 ---
ServerData/
[Aa]ssets/StreamingAssets/aa*
[Aa]ssets/AddressableAssetsData/link.xml*
[Aa]ssets/Addressables_Temp*
[Aa]ssets/AddressableAssetsData/*/*.bin*

# --- Visual Scripting 自动生成 ---
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# --- 测试自动生成场景 ---
[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
[Aa]ssets/[Ss]ceneDependencyCache*

# --- JetBrains Rider 插件 ---
[Aa]ssets/Plugins/Editor/JetBrains*

# ===== 操作系统 =====
.DS_Store
Thumbs.db

# ===== 本项目自有 =====
/_scratch/
